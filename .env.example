# All variables below are optional — anything left blank falls back to mock data.

# Todoist personal API token (Settings -> Integrations -> Developer)
VITE_TODOIST_API_TOKEN=

# Google Calendar OAuth client (Google Cloud Console -> Credentials)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=

# AI Quick Add — URL of the companion Cloudflare Worker that proxies Claude/
# Gemini calls (see cloudflare-worker/README.md to deploy your own). Optional:
# leave blank and the "AI Quick Add" button simply doesn't appear.
VITE_AI_QUICKADD_WORKER_URL=
