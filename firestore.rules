rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/backups/{backupId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Google Calendar refresh tokens (see cloudflare-worker/src/
    // googleCalendarAuthRoutes.js) are written/read ONLY by the Worker's
    // service-account-authenticated Firestore REST calls, which are
    // authorized by IAM, not by these rules. This match's real job is
    // guaranteeing no client-side Firebase SDK call — not even the signed-in
    // owner's own — can ever read or write this subcollection directly.
    match /users/{userId}/googleCalendarAuth/{document=**} {
      allow read, write: if false;
    }

    // ========================================================================
    // SHARED PROJECTS (collaboration — Phase 0)
    // ========================================================================
    // This is the app's FIRST cross-user data path. Everything above is
    // "only ever your own uid"; everything below deliberately lets another
    // user in, so the rules here carry the whole weight of the feature's
    // security requirement:
    //
    //   The ONLY way to reach another user's project is that project's own
    //   share link. Nothing may let a user enumerate, query, or read
    //   projects they haven't been explicitly added to.
    //
    // WHERE TOKENS LIVE, AND WHY NOT ON THIS DOCUMENT
    // -----------------------------------------------
    // Share tokens are secrets. They live in `sharedProjects/{id}/private/links`,
    // which NO client can read (`allow read: if false` below) — not the owner,
    // not a collaborator, nobody. Rules can still compare against them with
    // get(), which is the only access anything needs.
    //
    // They are deliberately NOT stored on the project document itself. That
    // was the original design and it was a CRITICAL privilege-escalation bug,
    // caught by an emulator probe during security review rather than by
    // reading the rules:
    //
    //   A `get` returns the ENTIRE document. Collaborators must be able to
    //   read the project doc to use the project at all — so with the tokens
    //   on that doc, ANY member could read `links.edit.token` in plaintext,
    //   re-join presenting it, and upgrade themselves viewer -> editor. A
    //   view-only collaborator could grant themselves write access to
    //   everything. Proven end-to-end: read token, re-join as editor, write
    //   tasks.
    //
    // The lesson generalizes: never put a secret in a document whose read rule
    // is broader than the secret's audience. Field-level read rules do not
    // exist in Firestore — the granularity of a read is one whole document —
    // so "secret" and "readable" have to be different documents.
    //
    // WHY TOKENS ARE CHECKED ON A WRITE, NEVER A READ
    // ----------------------------------------------
    // Token resolution is a join (a WRITE): presenting a valid token adds you
    // to `collaborators` at that link's role, and from then on ordinary
    // uid-based access applies. Gating a READ on a presented token instead
    // would be circular — you would need to read the doc to authorize reading
    // the doc.
    //
    // The presented token arrives as a custom auth claim (`request.auth.token
    // .joinToken`), NOT as a field in the written document. An earlier version
    // passed it as a doc field, which persisted it into the project document
    // on the join write and leaked it to every subsequent reader — same class
    // of bug as above. A claim is never written to Firestore, so it cannot
    // linger.
    //
    // Consequence, by design: an anonymous or logged-in visitor CANNOT read a
    // shared project until they have joined it. There is no read-only-by-token
    // path. That's intentional — it keeps "who can read this" answerable by
    // looking at exactly one field (`collaborators`) rather than by reasoning
    // about token propagation.
    match /sharedProjects/{projectId} {

      function existing() {
        return resource.data;
      }
      function incoming() {
        return request.resource.data;
      }
      function signedIn() {
        return request.auth != null;
      }
      function isOwner() {
        return signedIn() && existing().ownerId == request.auth.uid;
      }
      // A key in the collaborators map == has been admitted to THIS project.
      function isCollaborator() {
        return signedIn()
          && existing().collaborators is map
          && request.auth.uid in existing().collaborators;
      }
      function myRole() {
        return existing().collaborators[request.auth.uid].role;
      }
      function isEditor() {
        return isCollaborator() && myRole() == 'editor';
      }
      // Reading is membership-only — see the "WHY TOKENS ARE NOT CHECKED IN A
      // READ RULE" note above.
      function isMember() {
        return isOwner() || isCollaborator();
      }

      // --- Reads -------------------------------------------------------
      // `get` only, and only for members. `list` is NEVER granted on this
      // collection: without it, a project is unreachable unless you already
      // know its exact document ID, so no query can sweep up other people's
      // projects even if some other rule were mistakenly loosened. Note that
      // omitting `list` is not merely "we didn't add it" — it is the load-
      // bearing half of the non-discoverability requirement. Do not replace
      // these with a bare `allow read`, which grants list as well.
      allow get: if isMember();

      // --- Create ------------------------------------------------------
      // Only ever creates a project owned by yourself, and you must start as
      // the sole collaborator-of-record. Anonymous users can't create shared
      // projects — sharing is initiated by a real account.
      // A new shared project starts EMPTY of collaborators. Previously this
      // was only asserted in a comment, which let a creator prefill the map
      // with other people's uids at whatever role they liked — harmless alone
      // (those users would still need the project ID) but it made
      // "collaborators only ever grows by a verified join" untrue, and the
      // whole access model rests on that map.
      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && incoming().ownerId == request.auth.uid
        && incoming().collaborators is map
        && incoming().collaborators.keys().size() == 0
        && incoming().name is string
        && incoming().name.size() > 0
        && incoming().name.size() <= 200
        && incoming().keys().hasAll(['ownerId', 'name', 'collaborators'])
        // No `links` on this document — tokens live in private/links, which
        // only server-side code writes (see the private/ match below).
        && !('links' in incoming());

      // --- Owner writes ------------------------------------------------
      // The owner controls everything about the project. `ownerId` is the one
      // field with special handling: it may only change via a deliberate
      // ownership TRANSFER (below), never as an incidental part of some other
      // update, so a buggy client can't quietly reassign a project.
      // `collaborators` must stay a map on every owner write. `isCollaborator()`
      // guards with `collaborators is map` and returns false otherwise, so an
      // owner who wrote a string here (a plausible client bug, not just malice)
      // would lock every collaborator out of a project they can still see in
      // their own list. Owner-recoverable, but cheap to prevent outright.
      function ownerFieldsUnchanged() {
        return incoming().ownerId == existing().ownerId
          && incoming().collaborators is map
          && !('links' in incoming());
      }

      // --- Guest identity migration (deliberately NOT a rules path) ----
      // When an anonymous share-link guest signs in with a Google account
      // that already exists, `linkWithCredential` (which upgrades the
      // anonymous account IN PLACE, same uid, needing no migration at all)
      // is impossible, and the client ends up with a brand-new uid — see
      // AuthContext.jsx's handleGoogleCredential. Moving that guest's
      // `collaborators` entry to the new uid needs a write that swaps ANOTHER
      // uid's entry for the caller's own, which no branch of `allow update`
      // above grants (isRenamingSelf/joiningWithToken only ever touch the
      // caller's own key; the owner branch is scoped to the owner). Rules
      // have no way to verify the caller also controls that OTHER uid — that
      // needs a second, independently-verified id token, which a rules match
      // block cannot evaluate. This is handled by
      // cloudflare-worker/src/shareLinkRoutes.js's handleMigrateGuest instead
      // (POST /share/migrate-guest), which verifies both identities server-side
      // and writes via the service account that already bypasses these rules
      // for every other privileged operation in this file. See that route's
      // own header comment for the full reasoning and failure-mode analysis.


      // --- Ownership transfer ------------------------------------------
      // Owner-only, and deliberately narrow: the recipient must ALREADY be a
      // collaborator on this project, so a project can never be pushed onto
      // an arbitrary uid who never agreed to it. The recipient must also be a
      // real account — an anonymous visitor has no durable identity to own
      // anything. The outgoing owner stays on as an editor rather than losing
      // access to a project they may have created.
      // Rules cannot inspect the RECIPIENT's sign-in provider — `request.auth`
      // only ever describes the requester, and here the requester is the
      // outgoing owner. So anonymity is recorded on the collaborator entry at
      // join time from the joiner's own verified token (see
      // `joinEntryWellFormed`, which pins `isAnonymous` to the joiner's real
      // provider and so cannot be self-declared), and read back here.
      //
      // This check was previously only enforced client-side while the comment
      // above claimed the rules did it — a security review caught the gap. The
      // client is not a boundary: without this, a project could be handed to an
      // ephemeral anonymous identity that disappears when the visitor clears
      // storage, leaving it permanently unowned — nobody able to delete it,
      // rotate its links, or manage its collaborators.
      function recipientIsRealAccount() {
        return existing().collaborators[incoming().ownerId].isAnonymous != true;
      }
      function isTransferringOwnership() {
        return isOwner()
          && incoming().ownerId != existing().ownerId
          // Recipient was already admitted to this project.
          && incoming().ownerId in existing().collaborators
          && recipientIsRealAccount()
          // Outgoing owner is retained as an editor, not dropped.
          && incoming().collaborators[request.auth.uid].role == 'editor'
          // A transfer touches ownership, membership, and the denormalized
          // owner-profile fields (ownerDisplayName/ownerPhotoURL — see
          // sharedProjectService.js's createSharedProject/
          // transferSharedProjectOwnership) and nothing else. The share
          // tokens aren't on this document at all (private/links), so a
          // transfer can't disturb them.
          && request.resource.data.diff(existing()).affectedKeys()
               .hasOnly(['ownerId', 'collaborators', 'ownerDisplayName', 'ownerPhotoURL']);
      }

      // --- Editor writes -----------------------------------------------
      // An editor may edit project CONTENT but must not touch the fields that
      // govern access — `collaborators` (who's in) or `ownerId`. Without this,
      // "editor" would silently mean "can promote themselves to owner". The
      // share tokens are unreachable either way (private/links), and an editor
      // must not smuggle a `links` field back onto this document.
      // An editor may also only write the fields this document is actually made
      // of. Unconstrained, an editor could append arbitrary junk (a 500KB blob
      // was confirmed in review) to a document every member downloads on every
      // read — a storage/bandwidth cost borne by everyone, including the owner.
      // `ownerDisplayName`/`ownerPhotoURL` are in this list only so an editor's
      // ordinary write isn't rejected for carrying fields the document legitimately
      // has — `hasOnly` describes the whole document, not just what changed, so
      // omitting them here would deny EVERY editor write to a project that has
      // them. Editors can't meaningfully abuse them: `accessFieldsUnchanged()`
      // leaves them writable, but they're display-only strings, size-capped
      // below, and an editor who garbles them can already rename the project.
      function projectFieldsAllowed() {
        return incoming().keys().hasOnly(['ownerId', 'name', 'color', 'collaborators', 'createdAt', 'updatedAt', 'ownerDisplayName', 'ownerPhotoURL'])
          && incoming().name is string
          && incoming().name.size() > 0
          && incoming().name.size() <= 200
          && (!('color' in incoming())
              || (incoming().color is string && incoming().color.size() <= 40))
          && (!('ownerDisplayName' in incoming())
              || (incoming().ownerDisplayName is string && incoming().ownerDisplayName.size() <= 200))
          && (!('ownerPhotoURL' in incoming())
              || incoming().ownerPhotoURL == null
              || (incoming().ownerPhotoURL is string && incoming().ownerPhotoURL.size() <= 2000));
      }
      function accessFieldsUnchanged() {
        return incoming().ownerId == existing().ownerId
          && incoming().collaborators == existing().collaborators
          && !('links' in incoming())
          && projectFieldsAllowed();
      }

      // --- Join-by-token (the ONE place a token is evaluated) ----------
      // A visitor presenting a valid, enabled token adds ONLY themselves to
      // collaborators, at exactly the role that link grants. Everything else
      // about the document must be untouched by this write.
      //
      // The token comes from the client but is compared against the token
      // stored in the document by these rules, so the client cannot assert a
      // role it wasn't given. `request.resource.data.links` being required to
      // equal the existing links also means a joiner can't rotate tokens on
      // the way in.
      // A link is usable only if it exists, is enabled, and has not expired.
      // `expiresAt` is optional — absent/null means "never expires". When set
      // it is a Firestore TIMESTAMP (not an ISO string like most dates in this
      // app's own data model): rules can compare timestamps directly against
      // request.time but have no ISO-8601 parser, so storing it as a string
      // here would make the expiry check unenforceable server-side. The
      // comparison uses the server's own clock (request.time), never a
      // client-supplied "now", so a visitor can't revive a dead link by lying
      // about the time. Expiry is enforced here as well as client-side because
      // rules are the only real boundary; the client check exists purely to
      // render a friendly "link expired" state instead of an opaque
      // permission error.
      // The share links (tokens + enabled/expiry state) live in a document no
      // client can read — see "WHERE TOKENS LIVE" at the top of this block.
      // Rules read it with get(); that's the only access required.
      function links() {
        return get(/databases/$(database)/documents/sharedProjects/$(projectId)/private/links).data;
      }
      function linkUsable(linkKey) {
        return exists(/databases/$(database)/documents/sharedProjects/$(projectId)/private/links)
          && linkKey in links()
          && links()[linkKey].enabled == true
          && links()[linkKey].token is string
          && links()[linkKey].token.size() >= 20
          && (
            !('expiresAt' in links()[linkKey])
            || links()[linkKey].expiresAt == null
            || (links()[linkKey].expiresAt is timestamp
                && request.time < links()[linkKey].expiresAt)
          );
      }

      // `linkKey` ('edit'/'view', the key into `links`) and `collabRole`
      // ('editor'/'viewer', the value stored on a collaborators entry) are
      // deliberately two separate parameters, not one reused value — they
      // share a root word but are NOT the same string, and collapsing them
      // into a single parameter previously made this whole join path
      // silently always-false (comparing a stored role of 'editor' against
      // the literal 'edit' can never match).
      // The joiner's own entry must have exactly the expected shape. Without
      // this, `affectedKeys()` only sees that `collaborators` changed and never
      // inspects the entry's CONTENTS — a joiner could stuff arbitrary keys
      // (`adminOverride: true`) or hundreds of KB of junk inside their own
      // entry, on a document every member reads. Caught in security review.
      //
      // `isAnonymous` is pinned to the joiner's real, token-verified sign-in
      // provider rather than accepted from the client, because the ownership
      // transfer rule reads it back to refuse handing a project to an
      // ephemeral identity (see `recipientIsRealAccount`). A self-declared
      // value would make that check worthless.
      function joinEntry() {
        return incoming().collaborators[request.auth.uid];
      }
      function joinEntryWellFormed(collabRole) {
        return joinEntry().keys().hasOnly(['role', 'displayName', 'photoURL', 'joinedAt', 'isAnonymous'])
          && joinEntry().keys().hasAll(['role', 'displayName', 'joinedAt'])
          && joinEntry().role == collabRole
          && joinEntry().displayName is string
          && joinEntry().displayName.size() > 0
          && joinEntry().displayName.size() <= 120
          && (!('photoURL' in joinEntry())
              || joinEntry().photoURL == null
              || (joinEntry().photoURL is string && joinEntry().photoURL.size() <= 500))
          && joinEntry().isAnonymous == joinerIsAnonymous();
      }

      // Whether the JOINER is an ephemeral anonymous identity.
      //
      // This deliberately does NOT read `sign_in_provider`, and that is not an
      // oversight — reading it here was a real bug. A join can only happen in
      // a session created by `signInWithCustomToken` (that is how the
      // `joinToken` claim below arrives at all), and EVERY custom-token
      // session reports `sign_in_provider == 'custom'`, whatever the account
      // underneath actually is. So the old check
      //
      //     isAnonymous == (sign_in_provider == 'anonymous')
      //
      // was false for literally every joiner, including genuinely anonymous
      // ones — it recorded every anonymous visitor as a real account, quietly
      // defeating `recipientIsRealAccount()` and allowing a project to be
      // transferred to an identity that vanishes when that browser's storage
      // is cleared, leaving it permanently unowned.
      //
      // Instead the join endpoint reads the visitor's real provider from their
      // ORIGINAL id token — the last moment it is still visible — and mints it
      // as a `wasAnonymous` claim alongside `joinToken` (see
      // cloudflare-worker/src/googleAuth.js's verifyFirebaseIdTokenWithProvider).
      // Both claims come from the same server-signed token, so this is exactly
      // as trustworthy as the token check itself: a client cannot forge either
      // without forging the whole custom token, which requires the service
      // account's private key.
      //
      // The `in` guard is load-bearing and NOT redundant with the `== true`:
      // reading an absent property off `request.auth.token` is an ERROR in
      // rules, not a false — it aborts evaluation and denies the write rather
      // than falling through. Checking presence first means an older minted
      // token still in flight during a Worker deploy (one with no
      // `wasAnonymous` claim) degrades to "treat as a real account" instead of
      // breaking every join outright. Verified by the emulator suite, which
      // caught exactly this: the naive `== true` alone failed the
      // no-claim case with "Property wasAnonymous is undefined on object".
      function joinerIsAnonymous() {
        return 'wasAnonymous' in request.auth.token
          && request.auth.token.wasAnonymous == true;
      }

      // A join must never WEAKEN what the caller already has. The resolve
      // endpoint already applies this precedence server-side
      // (shareLinkLogic.js's effectiveJoinRole), but that alone left the
      // database itself permissive: any holder of a still-valid VIEW link could
      // demote themselves — or be demoted by a stale/replayed client — from
      // editor to viewer. Enforced here too so the floor is a property of the
      // data, not just of the one endpoint that happens to compute it.
      //
      // Only the editor->viewer direction can weaken, so that's the only case
      // to exclude; a viewer presenting an edit link is a legitimate upgrade.
      function joinDoesNotDowngrade(collabRole) {
        return collabRole == 'editor'
          || !(request.auth.uid in existing().collaborators)
          || existing().collaborators[request.auth.uid].role != 'editor';
      }
      function joiningWithToken(linkKey, collabRole) {
        return signedIn()
          // The owner is never a collaborator on their own project. This closes
          // the TOKEN path only — it does NOT stop an owner from writing their
          // own entry, because the owner branch above independently allows any
          // `collaborators` write (managing collaborators is the owner's job,
          // and rules can't distinguish a deliberate edit from an accidental
          // self-join). The real guard is server-side: the resolve endpoint
          // answers `already_owner` and never mints a join for the owner (see
          // shareLinkLogic.js's effectiveJoinRole).
          && request.auth.uid != existing().ownerId
          && linkUsable(linkKey)
          && joinDoesNotDowngrade(collabRole)
          // A join may ONLY add the joiner's own entry to `collaborators` and
          // touch nothing else on the document — no extra fields, no edits to
          // anyone else's entry.
          && request.resource.data.diff(existing()).affectedKeys().hasOnly(['collaborators'])
          && incoming().collaborators.diff(existing().collaborators).affectedKeys().hasOnly([request.auth.uid])
          && joinEntryWellFormed(collabRole);
      }
      // The presented token arrives as a custom auth claim, never as a field on
      // the written document — a doc field would be persisted into the project
      // and leak the token to every later reader (see the header comment). A
      // claim is verified by rules and never stored in Firestore.
      //
      // Minting that claim is the join endpoint's job (the token-resolution
      // step in Phase 0's spec): it validates the token server-side and issues
      // a custom token carrying `joinToken`. That keeps the secret comparison
      // on the server and off the document.
      function presentedTokenMatches(linkKey) {
        return request.auth.token.joinToken is string
          && request.auth.token.joinToken == links()[linkKey].token;
      }

      // --- Self-rename (a collaborator changing their OWN display name) ----
      // Neither the owner branch nor the editor branch above admits this: the
      // owner branch is gated to the owner's own uid, and the editor branch's
      // `accessFieldsUnchanged()` requires `collaborators` to be byte-identical
      // to what's stored, so even an editor renaming themselves would be
      // denied by it. A viewer has no branch at all. This is the narrow carve-
      // out: a collaborator (viewer OR editor, but not the owner — the owner's
      // name isn't stored in `collaborators` at all, see `ownerDisplayName`)
      // may touch ONLY their own entry's `displayName`, and only that one key
      // of it — not their `role` (privilege escalation), not their
      // `isAnonymous` flag (would defeat `recipientIsRealAccount()` on a later
      // ownership transfer), not `joinedAt`/`photoURL`.
      function isRenamingSelf() {
        return isCollaborator()
          // Touches `collaborators` and nothing else on the document.
          && request.resource.data.diff(existing()).affectedKeys().hasOnly(['collaborators'])
          // Within `collaborators`, only the caller's own key changes.
          && incoming().collaborators.diff(existing().collaborators).affectedKeys().hasOnly([request.auth.uid])
          // Within that one entry, only `displayName` changes — role/photoURL/
          // joinedAt/isAnonymous are all pinned to their existing values.
          && incoming().collaborators[request.auth.uid].diff(existing().collaborators[request.auth.uid]).affectedKeys().hasOnly(['displayName'])
          && incoming().collaborators[request.auth.uid].displayName is string
          && incoming().collaborators[request.auth.uid].displayName.size() > 0
          && incoming().collaborators[request.auth.uid].displayName.size() <= 120;
      }

      allow update: if
        // Owner: full control, but ownership itself only moves via the
        // dedicated transfer path below.
        (isOwner() && ownerFieldsUnchanged())
        // Owner hands the project to an existing collaborator.
        || isTransferringOwnership()
        // Editor: content only, never the access-control fields.
        || (isEditor() && accessFieldsUnchanged())
        // Any collaborator (viewer or editor) renaming only their own entry.
        || isRenamingSelf()
        // Self-join at a link's role, token verified against the stored token.
        || (joiningWithToken('edit', 'editor') && presentedTokenMatches('edit'))
        || (joiningWithToken('view', 'viewer') && presentedTokenMatches('view'));

      // Only the owner can delete a shared project outright.
      allow delete: if isOwner();

      // --- Project content subcollections ------------------------------
      // Tasks/sections/comments of a shared project. Access is derived from
      // the PARENT project's membership via get() — so a valid link to one
      // project grants nothing anywhere else, satisfying "a link only ever
      // grants access to that one project's own data".
      function parent() {
        return get(/databases/$(database)/documents/sharedProjects/$(projectId)).data;
      }
      function parentOwner() {
        return signedIn() && parent().ownerId == request.auth.uid;
      }
      function parentCollaborator() {
        return signedIn()
          && parent().collaborators is map
          && request.auth.uid in parent().collaborators;
      }
      function parentEditor() {
        return parentCollaborator()
          && parent().collaborators[request.auth.uid].role == 'editor';
      }

      // Tasks and sections: members read, owner/editors write. `list` IS
      // allowed here (unlike the project collection itself) — you can only
      // reach this path by already knowing the project ID and passing the
      // membership check, so querying within a project you belong to is fine
      // and is what the live sync listener needs.
      // Comments are NOT a subcollection: they're embedded in the task
      // document's own `comments` array (with `deletedCommentIds` tombstones
      // alongside — see utils/sharedTaskSync.js's mergeComments), so they're
      // covered by the task write rule here and need no rule of their own. That
      // does mean commenting requires edit rights: a viewer's comment would be
      // denied at the whole-task level, so the client renders the composer
      // read-only for viewers (see TaskDetailModal.jsx) rather than loosening
      // this rule — a per-field "only the comments array changed" exception
      // isn't cheaply expressible here, and widening the whole-task write would
      // let a viewer edit title/dates/completion too.
      match /tasks/{taskId} {
        allow read: if parentOwner() || parentCollaborator();
        allow write: if parentOwner() || parentEditor();
      }

      match /sections/{sectionId} {
        allow read: if parentOwner() || parentCollaborator();
        allow write: if parentOwner() || parentEditor();
      }

      // Presence heartbeats (Phase 1 uses these for viewer avatars). You may
      // only ever write your OWN presence doc, and its shape is constrained:
      // unvalidated, a viewer could write hundreds of KB here, or set
      // `displayName: 'Owner'` and impersonate someone in the avatar strip.
      // Presence is display-only data, so keep it to the few small fields the
      // UI actually renders.
      match /presence/{presenceUid} {
        allow read: if parentOwner() || parentCollaborator();
        allow write: if (parentOwner() || parentCollaborator())
          && request.auth.uid == presenceUid
          && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'lastSeenAt'])
          && (!('displayName' in request.resource.data)
              || (request.resource.data.displayName is string
                  && request.resource.data.displayName.size() <= 120))
          && (!('photoURL' in request.resource.data)
              || request.resource.data.photoURL == null
              || (request.resource.data.photoURL is string
                  && request.resource.data.photoURL.size() <= 500));
      }

      // Share-link secrets: `private/links` holds the view/edit tokens plus
      // their enabled/expiry state. NO client may read or write this, ever —
      // not even the project owner. Rules read it via get() (see links()
      // above), and only privileged server code (the join endpoint / a
      // service-account context, which bypasses these rules entirely) creates
      // or rotates it. Same pattern as the googleCalendarAuth block above:
      // a hard `false` is the guarantee that no client-side SDK call, however
      // buggy or malicious, can exfiltrate a token.
      //
      // Owner-facing "show me my share link" therefore cannot read this doc
      // directly — the server hands the owner their link when they generate or
      // request it. That's deliberate: the alternative (let the owner read it)
      // reintroduces a readable secret and, since rules can't express "only
      // the owner may read this ONE field", would put us back where the
      // escalation bug came from.
      match /private/{document=**} {
        allow read, write: if false;
      }
    }

    // Reverse index from a share-link TOKEN to the project it belongs to
    // (`shareTokens/{token} -> {projectId, linkType}`), written/read only by
    // the Cloudflare Worker's service-account calls (cloudflare-worker/src/
    // shareLinkRoutes.js) — never by any client SDK, same pattern as
    // `googleCalendarAuth` and `private/links` above. A visitor who clicks a
    // share link has only the token, not the project id, and cannot query
    // Firestore for "which project has this token" (no client can read
    // `private/links` at all, and there is no cross-document query that
    // could answer this even if they could) — this index is the server-side
    // shortcut from token to project id.
    //
    // Is a doc keyed BY the secret token itself safe? Yes: nobody can `list`
    // this collection (not granted, same as `sharedProjects`), so a doc here
    // is only reachable by already knowing its exact ID — which IS the
    // token. Knowing this collection exists gets an attacker nothing without
    // already holding a valid token string, so this index doesn't create any
    // new way to guess, enumerate, or leak a token; it only lets someone who
    // already has one resolve it faster. `allow read, write: if false` means
    // even that direct lookup is unavailable to a client — only the Worker's
    // IAM-authorized service-account REST calls can touch it.
    match /shareTokens/{token} {
      allow read, write: if false;
    }

    // Display names chosen by anonymous link visitors. A visitor owns exactly
    // their own doc, keyed by their anonymous auth uid. Readable by any signed
    // in user because collaborator avatars/names have to render for everyone
    // in a shared project — these docs hold a self-chosen display name and
    // nothing else, so keep it that way: never add anything sensitive here.
    // Shape-constrained for the same reason as presence above: without it an
    // anonymous user can write an arbitrarily large document here. `list` is
    // deliberately not granted, so these can't be swept up in bulk — a reader
    // has to already know a specific (unguessable) uid.
    match /anonProfiles/{profileUid} {
      allow get: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == profileUid
        && request.resource.data.keys().hasOnly(['displayName', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120;
    }
  }
}
